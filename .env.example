# GHASILAK / غسيلك — Environment template (NO REAL SECRETS)

# Copy this file to `.env.local` and paste YOUR real values from Supabase / Vercel.
# Never commit `.env.local`. Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* vars.

# =============================================================================
# Supabase — Project Settings → API
# =============================================================================

# Project URL (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe in the browser because RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRET — server only). Required for customer place-order.
# Find it under Project Settings → API → service_role (click Reveal).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Database connection string for one-off SQL seed via psql
# Project Settings → Database → Connection string (URI)
# DATABASE_URL=

# =============================================================================
# App
# =============================================================================

# Local: http://127.0.0.1:43123
# Production: https://YOUR_DOMAIN (set this on Vercel after you have a domain)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Default language: ar (Arabic) or en
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Public WhatsApp support number with country code, e.g. +9689xxxxxxx
# Shown on the website / deep links. You can also set this later in Admin → Settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# =============================================================================
# Auth notes (no passwords in git)
# =============================================================================
# 1) Create users in Supabase Dashboard → Authentication → Users
# 2) Promote admin with supabase/scripts/create-first-admin.sql
# 3) Promote driver with supabase/scripts/create-driver.sql
# Customer signup can use email/password from the app; phone OTP needs an SMS provider.
